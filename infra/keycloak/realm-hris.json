{
  "realm": "hris",
  "displayName": "HRIS Cleteci",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "people-talent",
        "description": "People & Talent"
      },
      {
        "name": "administracion",
        "description": "Administración / Finanzas"
      },
      {
